rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to user's subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Attendance records - user-specific
    match /attendance_records/{recordId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Chat conversations - user-specific
    match /chat_conversations/{conversationId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
        
      // Messages within conversations
      match /messages/{messageId} {
        allow read, write, create: if request.auth != null;
      }
    }
    
    // Courses - user-specific
    match /courses/{courseId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Notes - user-specific  
    match /notes/{noteId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Flashcard generations - user-specific
    match /flashcard_generations/{generationId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Flashcards - user-specific
    match /flashcards/{flashcardId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Flashcard reviews - user-specific
    match /flashcard_reviews/{reviewId} {
      allow read, write, create: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid || 
         resource.data.userId == request.auth.uid);
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}